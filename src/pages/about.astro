---
import Site from '../layouts/Site.astro';
---
<Site title="About — Found in PT">

  <section class="hero">
    <h1><span class="brand-coral">found in pt</span> is a place for all the artists, makers, and crafters of Port Townsend.</h1>
  </section>

  <section class="about">
    <div class="about-text">
      <p class="about-label">About</p>
      <h2 class="about-heading">A home for the people making things in Port Townsend.</h2>
      <div class="about-body">
        <p>Found in PT is a curated directory connecting visitors and locals with the artists, makers, and crafters working in and around town — painters, potters, jewelers, woodworkers, weavers, and more.</p>
        <p>It's a small project from people who live here, free to be listed in, and built to highlight the creative community that gives Port Townsend its character.</p>
      </div>
      <a class="about-cta" href="/artists">Browse the directory <span aria-hidden="true">→</span></a>
    </div>
    <div class="about-image" style="background-image:url('/hero-pt.png');"></div>
  </section>

</Site>
