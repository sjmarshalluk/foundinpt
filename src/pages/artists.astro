---
import Site from '../layouts/Site.astro';
import { creators, creatorSection, CREATOR_SECTIONS, isMaker, shortName, primaryTag, hashColor, heroImageSrc } from '../lib/data.js';
import '../styles/directory.css';

const list = creators();

// One section per CREATOR_SECTIONS entry, plus a final "Other" bucket.
const sections = [
  ...CREATOR_SECTIONS.map((s) => ({ key: s.label, label: s.label, entries: [] })),
  { key: 'Other', label: 'Other', entries: [] },
];
const byKey = Object.fromEntries(sections.map((s) => [s.key, s]));
for (const e of list) byKey[creatorSection(e)].entries.push(e);

// Hide empty sections.
const visibleSections = sections.filter((s) => s.entries.length > 0);
---
<Site title="Artists & Makers — Found in PT">

  <p class="dir-intro">The painters, potters, jewelers, woodworkers, weavers, and other people making original work in and around Port Townsend.</p>

  {visibleSections.map((s) => (
    <section class="space-section" data-section={s.key}>
      <h2 class="section-heading">{s.label}</h2>
      <div class="dir-grid">
        {s.entries.map((e) => {
          const hero = heroImageSrc(e, isMaker(e) ? 'maker' : 'artist');
          const skills = (e.skills || []).join(' ');
          const search = `${e.name || ''} ${skills}`.toLowerCase();
          return (
            <a href={`/entity/${e.id}/`} class="maker-card" data-search={search} data-section={s.key}>
              <div class="maker-thumb" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : `background:${hashColor(e.id)};`} ></div>
              <div class="maker-info">
                <span class="maker-name">{shortName(e)}</span>
                {e.skills?.length > 0 && <span class="maker-skills">{e.skills.join(' · ')}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section class="register-cta">
    <div class="register-cta-grid">
      <div class="register-cta-card">
        <h2 class="register-cta-title">Are you an artist or maker in Port Townsend?</h2>
        <p class="register-cta-desc">Get listed in the directory and be found by visitors and locals looking for original, locally-made work. Free, forever.</p>
        <a href="/register" class="register-cta-btn">Apply to be listed</a>
      </div>
      <div class="register-cta-card">
        <h2 class="register-cta-title">Sign up to get updates</h2>
        <p class="register-cta-desc">Occasional updates as new artists, makers, and places are added to Found in PT.</p>
        <form id="dir-updates-form" class="dir-updates-form"
              action="https://assets.mailerlite.com/jsonp/2278716/forms/185204736057672765/subscribe"
              method="post">
          <input type="email" name="fields[email]" required placeholder="Email address" autocomplete="email" aria-label="Email" class="dir-updates-input" />
          <button type="submit" class="dir-updates-btn">Sign up</button>
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
        </form>
        <p id="dir-updates-success" class="dir-updates-success" hidden>Thanks — you're on the list.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('dir-updates-form');
      const success = document.getElementById('dir-updates-success');
      if (!form || !success) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        try { fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' }); } catch (err) {}
        form.hidden = true;
        success.hidden = false;
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const cards = document.querySelectorAll('.maker-card');
      const totalCountEl = document.getElementById('visible-count');
      const searchEl = document.getElementById('dir-search');
      const sectionCountEls = document.querySelectorAll('[data-section-count]');
      let query = '';

      function refilter() {
        let total = 0;
        const perSection = {};
        cards.forEach((card) => {
          const matchQuery = !query || (card.dataset.search || '').includes(query);
          card.style.display = matchQuery ? '' : 'none';
          if (matchQuery) {
            total++;
            const sec = card.dataset.section;
            perSection[sec] = (perSection[sec] || 0) + 1;
          }
        });
        if (totalCountEl) totalCountEl.textContent = total;
        sectionCountEls.forEach((el) => {
          const sec = el.dataset.sectionCount;
          el.textContent = perSection[sec] || 0;
        });
      }

      if (searchEl) {
        searchEl.addEventListener('input', () => {
          query = searchEl.value.trim().toLowerCase();
          refilter();
        });
      }
    })();
  </script>

</Site>
