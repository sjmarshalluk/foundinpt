---
import Site from '../layouts/Site.astro';
---
<Site title="Found in PT">

  <section class="hero hero-coming-soon">
    <p class="hero-tag">Coming soon</p>
    <h1><span class="brand-coral">found in pt</span> — a place for the artists, makers, and crafters of Port Townsend.</h1>
    <p class="hero-sub"><a href="/about">Learn more</a></p>
  </section>

</Site>

<style is:global>
  .hero-coming-soon {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-tag {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--white);
    opacity: 0.7;
    margin-bottom: 24px;
  }
  .hero-sub {
    margin-top: 32px;
    font-size: 0.95rem;
    color: var(--white);
    opacity: 0.85;
  }
  .hero-sub a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .hero-sub a:hover { color: var(--coral); }
</style>
