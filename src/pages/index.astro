---
import Site from '../layouts/Site.astro';
---
<Site title="Made in PT">

  <section class="home-hero">
    <div class="home-hero-inner">
      <h1 class="home-h1">Port Townsend is full of artists, makers, and creators. <span class="home-h1-soft">Find one to inspire and support.</span></h1>
      <div class="home-ctas">
        <a href="/artists" class="home-cta home-cta-primary">Explore directory</a>
        <a href="#get-listed" class="home-cta">Get listed</a>
      </div>
      <div class="home-hero-image" style="background-image:url('/hero-pt.png');"></div>
    </div>
  </section>

  <section class="signup">

    <div class="signup-path">
      <p class="path-label">For visitors &amp; locals</p>
      <h2 class="path-title">Follow the launch</h2>
      <ul class="path-benefits">
        <li>Find artists and makers who actually live and work here</li>
        <li>Discover studios, markets, and open days in one place</li>
        <li>Buy directly from the people who made it</li>
        <li>Support a creative community that shapes this town</li>
      </ul>

      <div id="mlb2-40128546" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-40128546">
        <div class="ml-form-embedWrapper embedForm">
          <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
            <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/2278716/forms/185204736057672765/subscribe" data-code="" method="post" target="_blank">
              <div class="ml-form-formContent">
                <div class="ml-form-fieldRow ml-last-item">
                  <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                    <input aria-label="email" aria-required="true" type="email" class="form-control" name="fields[email]" placeholder="Email address" autocomplete="email">
                  </div>
                </div>
              </div>
              <div class="ml-form-checkboxRow ml-validate-required">
                <label class="checkbox">
                  <input type="checkbox">
                  <div class="label-description"><p>I'd like occasional updates about Made in PT.</p></div>
                </label>
              </div>
              <input type="hidden" name="ml-submit" value="1">
              <div class="ml-form-embedSubmit">
                <button type="submit" class="primary">Get updates</button>
                <button disabled="disabled" style="display:none" type="button" class="loading">
                  <div class="ml-form-embedSubmitLoad"></div>
                  <span class="sr-only">Loading...</span>
                </button>
              </div>
              <input type="hidden" name="anticsrf" value="true">
            </form>
          </div>
          <div class="ml-form-successBody row-success" style="display:none">
            <div class="ml-form-successContent">
              <h4>You're on the list.</h4>
              <p>We'll be in touch as the site launches.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="signup-path" id="get-listed">
      <p class="path-label">For artists &amp; makers</p>
      <h2 class="path-title">Apply to be featured</h2>
      <ul class="path-benefits">
        <li>Get found by visitors looking to buy local, original work</li>
        <li>A permanent home for your practice beyond social media</li>
        <li>Part of a curated directory, not an algorithm</li>
        <li>Free to be listed, forever</li>
      </ul>

      <div id="mlb2-40128654" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-40128654">
        <div class="ml-form-embedWrapper embedForm">
          <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
            <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/2278716/forms/185204929500022263/subscribe" data-code="" method="post" target="_blank">
              <div class="ml-form-formContent">
                <div class="ml-form-fieldRow">
                  <div class="ml-field-group ml-field-name">
                    <input aria-label="name" type="text" class="form-control" name="fields[name]" placeholder="Name or studio name" autocomplete="given-name">
                  </div>
                </div>
                <div class="ml-form-fieldRow">
                  <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                    <input aria-label="email" aria-required="true" type="email" class="form-control" name="fields[email]" placeholder="Email address" autocomplete="email">
                  </div>
                </div>
                <div class="ml-form-fieldRow">
                  <div class="ml-field-group ml-field-maker_type ml-validate-required">
                    <input aria-label="maker_type" aria-required="true" type="text" class="form-control" name="fields[maker_type]" placeholder="What do you make?">
                  </div>
                </div>
                <div class="ml-form-fieldRow">
                  <div class="ml-field-group ml-field-socials">
                    <input aria-label="socials" type="text" class="form-control" name="fields[socials]" placeholder="Website or Instagram (optional)">
                  </div>
                </div>
                <div class="ml-form-fieldRow ml-last-item">
                  <div class="ml-field-group ml-field-notes">
                    <input aria-label="notes" type="text" class="form-control" name="fields[notes]" placeholder="Anything else you want to share? (optional)">
                  </div>
                </div>
              </div>
              <div class="ml-form-checkboxRow ml-validate-required">
                <label class="checkbox">
                  <input type="checkbox">
                  <div class="label-description"><p>I'd like occasional updates about Made in PT.</p></div>
                </label>
              </div>
              <input type="hidden" name="ml-submit" value="1">
              <div class="ml-form-embedSubmit">
                <button type="submit" class="primary">Apply as a maker</button>
                <button disabled="disabled" style="display:none" type="button" class="loading">
                  <div class="ml-form-embedSubmitLoad"></div>
                  <span class="sr-only">Loading...</span>
                </button>
              </div>
              <input type="hidden" name="anticsrf" value="true">
            </form>
          </div>
          <div class="ml-form-successBody row-success" style="display:none">
            <div class="ml-form-successContent">
              <h4>Application received.</h4>
              <p>We'll be in touch as we add creators to Made in PT.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <script is:inline>
    function ml_webform_success_40128546() {
      var el = document.querySelector('.ml-subscribe-form-40128546 .row-success');
      var frm = document.querySelector('.ml-subscribe-form-40128546 .row-form');
      if (el) el.style.display = 'block';
      if (frm) frm.style.display = 'none';
    }
    function ml_webform_success_40128654() {
      var el = document.querySelector('.ml-subscribe-form-40128654 .row-success');
      var frm = document.querySelector('.ml-subscribe-form-40128654 .row-form');
      if (el) el.style.display = 'block';
      if (frm) frm.style.display = 'none';
    }
  </script>
  <script is:inline src="https://groot.mailerlite.com/js/w/webforms.min.js?v95037e5bac78f29ed026832ca21a7c7b"></script>
  <script is:inline>
    fetch("https://assets.mailerlite.com/jsonp/2278716/forms/185204736057672765/takel");
    fetch("https://assets.mailerlite.com/jsonp/2278716/forms/185204929500022263/takel");
  </script>

</Site>

<style is:global>
  .home-hero {
    padding: clamp(48px, 7vw, 96px) var(--pad) clamp(48px, 6vw, 80px);
  }
  .home-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .home-h1 {
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin-bottom: 36px;
  }
  .home-h1-soft { color: var(--mid); font-weight: 500; }

  .home-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .home-cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--black);
    background: var(--white);
    border: 1px solid var(--black);
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  .home-cta:hover {
    background: var(--black);
    color: var(--white);
  }
  .home-cta-primary {
    background: var(--black);
    color: var(--white);
  }
  .home-cta-primary:hover {
    background: var(--coral);
    border-color: var(--coral);
    color: var(--white);
  }

  .home-hero-image {
    aspect-ratio: 16 / 7;
    width: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 16px;
  }

  /* Reasons list inside each signup-path card */
  .path-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .path-benefits li {
    font-size: 1rem;
    color: var(--black);
    line-height: 1.5;
    padding-left: 22px;
    position: relative;
  }
  .path-benefits li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--mid);
  }

  @media (max-width: 600px) {
    .home-hero-image { aspect-ratio: 4 / 3; }
  }
</style>
