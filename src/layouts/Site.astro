---
const { title = 'Found in PT', description = "A directory of artists, makers, and crafters in and around Port Townsend." } = Astro.props;
import '../styles/style.css';
const path = Astro.url.pathname;
const hasHeroBg = path === '/' || path === '' || path === '/about' || path === '/about/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body class={hasHeroBg ? 'is-home' : ''}>
  <header>
    <a href="/" class="logo-text" aria-label="Found in PT"><img src="/logo.svg" alt="Found in PT" /></a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="site-nav" id="site-nav">
      <a href="/shop">Shop</a>
      <a href="/community">Community</a>
      <a href="/about">About</a>
      <div class="nav-dropdown">
        <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false">
          Directory
          <span class="nav-caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-menu" role="menu">
          <a href="/artists">Artists &amp; Makers</a>
          <a href="/spaces">Galleries &amp; Shops</a>
          <a href="/farms">Farms &amp; Producers</a>
          <a href="/studios-and-classes">Studios &amp; Classes</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <span>Found in PT &mdash; Port Townsend, WA</span>
  </footer>

  <script is:inline>
    (function () {
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (!btn || !nav) return;
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('nav-open', open);
      });
      nav.addEventListener('click', (e) => {
        if (e.target.tagName === 'A') {
          nav.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('nav-open');
        }
      });
    })();
  </script>
</body>
</html>

<style is:global>
  header { display: flex; justify-content: space-between; align-items: center; }

  .site-nav {
    font-size: 1rem;
    font-weight: 500;
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .site-nav > a,
  .nav-trigger {
    color: var(--mid);
    padding: 8px 0;
  }
  .site-nav > a:hover,
  .nav-trigger:hover { color: var(--coral); }

  .nav-dropdown { position: relative; }
  .nav-trigger {
    appearance: none;
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-caret { font-size: 0.7em; line-height: 1; }

  .nav-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background: var(--white);
    border: 1px solid #eee;
    padding: 6px 0;
    min-width: 260px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    display: none;
    z-index: 10;
  }
  .nav-menu a {
    display: block;
    padding: 10px 18px;
    color: var(--black);
    font-size: 0.95rem;
  }
  .nav-menu a:hover {
    background: #f4f4f4;
    color: var(--coral);
  }
  .nav-dropdown:hover .nav-menu,
  .nav-dropdown:focus-within .nav-menu { display: block; }

  /* ── Hamburger ── */
  .nav-toggle {
    display: none;
    appearance: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    position: relative;
    z-index: 30;
  }
  .nav-toggle-bar {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--mid);
    margin: 6px 0;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  .is-home .nav-toggle-bar { background: var(--white); }
  .is-home .nav-toggle[aria-expanded="true"] .nav-toggle-bar { background: var(--black); }

  body.nav-open { overflow: hidden; }

  @media (max-width: 780px) {
    .nav-toggle { display: block; }

    .site-nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 96px var(--pad) 32px;
      background: var(--white);
      overflow-y: auto;
      transform: translateY(-100%);
      transition: transform 220ms ease;
      z-index: 20;
    }
    .site-nav.is-open { transform: translateY(0); }

    .site-nav > a,
    .nav-trigger {
      width: 100%;
      padding: 18px 0;
      border-bottom: 1px solid #eee;
      color: var(--black) !important;
      font-size: 1.25rem;
      font-weight: 500;
    }

    .nav-dropdown { position: static; }
    .nav-trigger {
      pointer-events: none;
      color: var(--mid) !important;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 24px 0 12px;
      border-bottom: none;
    }
    .nav-caret { display: none; }

    .nav-menu {
      position: static;
      display: block;
      border: none;
      box-shadow: none;
      padding: 0;
      min-width: 0;
      background: transparent;
    }
    .nav-menu a {
      padding: 14px 0;
      font-size: 1.1rem;
      border-bottom: 1px solid #eee;
    }
    .nav-menu a:hover { background: transparent; color: var(--coral); }
  }
</style>
